# Copy to .env and adjust. Used only by the Vite dev server (npm run dev).
# Backend the dev server forwards /api and /health to:
#   http://localhost:8080   backend started from the IDE (default)
#   http://localhost:8081   IDE backend with ZW_PORT=8081
#   http://localhost:18080  the docker compose stack (ZW_HTTP_PORT=18080)
ZW_API=http://localhost:8080
