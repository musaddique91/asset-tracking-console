#!/bin/bash
# Diagnostics from inside a backend container, with nothing but bash:
#   docker compose exec backend-1 /app/bin/zwctl health|metrics|prom|stats
set -euo pipefail
get() {
  exec 3<>/dev/tcp/127.0.0.1/8080
  printf 'GET %s HTTP/1.0\r\nHost: localhost\r\n\r\n' "$1" >&3
  sed -e '1,/^\r$/d' <&3
  exec 3>&-
}
case "${1:-health}" in
  health) get /health; echo ;;
  prom) get /actuator/prometheus | grep -E '^(zw_|http_server_requests_seconds_count|hikaricp_connections)' ;;
  metrics) get /actuator/prometheus | grep -E '^zw_' ;;
  *) echo "usage: zwctl health|metrics|prom" >&2; exit 2 ;;
esac
